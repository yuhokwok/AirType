    "Enter sends text · Shift + Enter adds a draft line. With an empty draft, Enter sends Return and Backspace sends Delete. Keep AirType open.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter sends text · Shift + Enter adds a draft line. With an empty draft, Enter sends Return and Backspace sends Delete. Keep AirType open."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter 傳送文字 · Shift + Enter 在草稿換行。草稿空白時，Enter 在裝置上換行，Backspace 刪除一個字元。請保持 AirType 鍵盤開啟。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter 发送文字 · Shift + Enter 在草稿换行。草稿空白时，Enter 在设备上换行，Backspace 删除一个字符。请保持 AirType 键盘开启。"
          }
        }
      }
    },
