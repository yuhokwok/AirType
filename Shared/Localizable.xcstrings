    "With an empty draft, `Enter / Return` inserts a new line and `Backspace / Delete` deletes a character on your device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With an empty draft, `Enter / Return` inserts a new line and `Backspace / Delete` deletes a character on your device."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿空白時，「`Enter / Return`」會在裝置上換行，「`Backspace / Delete`」會刪除裝置上的一個字元。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿空白时，「`Enter / Return`」会在装置上换行，「`Backspace / Delete`」会删除装置上的一个字符。"
          }
        }
      }
    },
    "Use `Shift + Enter` to add a line to the browser draft.": {
