    "Settings → General → Keyboard → Keyboards → Add New Keyboard → AirType. Then enable Allow Full Access.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings → General → Keyboard → Keyboards → Add New Keyboard → AirType. Then enable Allow Full Access."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 → 一般 → 鍵盤 → 鍵盤 → 加入新鍵盤 → AirType，再開啟「允許完整取用」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 → 一般 → 键盘 → 键盘 → 加入新键盘 → AirType，再开启「允许完全访问」。"
          }
        }
      }
    },
