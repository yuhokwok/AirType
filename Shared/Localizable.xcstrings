    },
    "Save connection name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save connection name"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存連線名稱"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "储存连接名称"
          }
        }
      }
    },
    "Saved. Reopen the keyboard to apply.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved. Reopen the keyboard to apply."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存，重新開啟 AirType 鍵盤即可套用。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已储存，重新开启 AirType 键盘即可套用。"
          }
        }
      }
    },
    "Default: airtype.local:8307. If the name is already taken, AirType adds -2, -3, and so on. Use the address shown on the keyboard; its IP address is also available there.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default: airtype.local:8307. If the name is already taken, AirType adds -2, -3, and so on. Use the address shown on the keyboard; its IP address is also available there."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設：airtype.local:8307。如名稱已被使用，AirType 會加上 -2、-3 等後綴。請使用鍵盤顯示的地址，亦可在該處查看 IP 地址。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预设：airtype.local:8307。如名称已被使用，AirType 会加上 -2、-3 等后缀。请使用键盘显示的地址，亦可在该处查看 IP 地址。"
          }
        }
      }
    },
    "Checking…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查中⋯"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查中⋯"
          }
        }
      }
    },
    "Run network check": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run network check"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行網絡檢查"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "执行网络检查"
          }
        }
      }
    },
    "Open AirType Settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open AirType Settings"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 AirType 設定"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启 AirType 设置"
          }
        }
      }
    },
    "Network diagnostics": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network diagnostics"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網絡診斷"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络诊断"
          }
        }
      }
    },
    "This checks Bonjour on this device. A successful check does not confirm that your computer is connected.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This checks Bonjour on this device. A successful check does not confirm that your computer is connected."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此功能會檢查本機的 Bonjour 服務。檢查成功並不代表電腦已連線。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此功能会检查本机的 Bonjour 服务。检查成功并不代表电脑已连接。"
          }
        }
      }
    },
    "Connection help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection help"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線說明"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接说明"
          }
        }
      }
    },
    "Keep your computer and iPhone on the same Wi-Fi, and keep the AirType keyboard visible. Open the address displayed on the keyboard in your computer browser and enter its six-digit pairing code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your computer and iPhone on the same Wi-Fi, and keep the AirType keyboard visible. Open the address displayed on the keyboard in your computer browser and enter its six-digit pairing code."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請讓電腦與 iPhone 連接同一個 Wi-Fi，並保持 AirType 鍵盤開啟。在電腦瀏覽器輸入鍵盤顯示的地址，再輸入六位數配對碼。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请让电脑与 iPhone 连接同一个 Wi-Fi，并保持 AirType 键盘开启。在电脑浏览器输入键盘显示的地址，再输入六位数配对码。"
          }
        }
      }
    },
    "If the name does not open, tap the keyboard’s address bar and try its IP fallback. Guest Wi-Fi, client isolation or a VPN may prevent the connection.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the name does not open, tap the keyboard’s address bar and try its IP fallback. Guest Wi-Fi, client isolation or a VPN may prevent the connection."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如無法開啟名稱地址，點一下鍵盤的地址列，改用 IP 地址。訪客 Wi-Fi、用戶端隔離或 VPN 可能阻擋連線。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如无法开启名称地址，点一下键盘的地址列，改用 IP 地址。访客 Wi-Fi、用户端隔离或 VPN 可能阻挡连接。"
          }
        }
      }
    },
    "Keyboard setup help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard setup help"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵盤設定說明"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘设置说明"
          }
        }
      }
    },
    "Settings → General → Keyboard → Keyboards → Add New Keyboard → AirType. Open AirType’s keyboard entry and enable Allow Full Access for networking.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings → General → Keyboard → Keyboards → Add New Keyboard → AirType. Open AirType’s keyboard entry and enable Allow Full Access for networking."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 → 一般 → 鍵盤 → 鍵盤 → 加入新鍵盤 → AirType。在 AirType 鍵盤項目開啟「允許完整取用」，以使用網絡連線。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 → 一般 → 键盘 → 键盘 → 加入新键盘 → AirType。在 AirType 键盘项目开启「允许完全访问」，以使用网络连接。"
          }
        }
      }
    },
    "Local Network permission and keyboard Full Access are separate. The app cannot confirm your Full Access setting; check it in Settings if connection fails.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local Network permission and keyboard Full Access are separate. The app cannot confirm your Full Access setting; check it in Settings if connection fails."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「區域網絡」權限與鍵盤的「完整取用」是獨立設定。App 無法確認完整取用狀態；如連線失敗，請到「設定」檢查。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「本地网络」权限与键盘的「完全访问」是独立设置。App 无法确认完全访问状态；如连接失败，请到「设置」检查。"
          }
        }
      }
    },
    "Preview keyboard & Web Access": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview keyboard & Web Access"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽鍵盤與網頁輸入"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览键盘与网页输入"
          }
        }
      }
    },
    "Keyboard preview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard preview"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵盤預覽"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘预览"
          }
        }
      }
    },
    "Preview works inside this app. It does not confirm that the system keyboard is enabled. Use Try AirType on the home screen to test the installed keyboard.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview works inside this app. It does not confirm that the system keyboard is enabled. Use Try AirType on the home screen to test the installed keyboard."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽只在此 App 內運作，並不代表系統鍵盤已啟用。請使用首頁的「試用 AirType」測試已安裝的鍵盤。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览只在此 App 内运作，并不代表系统键盘已启用。请使用首页的「试用 AirType」测试已安装的键盘。"
          }
        }
      }
    },
    "Privacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "私隱"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐私"
          }
        }
      }
    },
    "Full Access lets the keyboard connect to your computer. AirType uses your local network, has no cloud service and does not store your typing. Use a trusted Wi-Fi network.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Access lets the keyboard connect to your computer. AirType uses your local network, has no cloud service and does not store your typing. Use a trusted Wi-Fi network."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完整取用讓鍵盤與電腦連線。AirType 只使用區域網絡，沒有雲端服務，亦不會儲存輸入內容。請使用可信任的 Wi-Fi 網絡。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完全访问让键盘与电脑连接。AirType 只使用本地网络，没有云端服务，亦不会储存输入内容。请使用可信任的 Wi-Fi 网络。"
          }
        }
      }
    },
