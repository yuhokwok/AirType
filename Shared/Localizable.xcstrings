        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 引言"
          }
        }
      }
    },
    "policy.1.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the privacy policy for AirType (invivo interactive limited), our products including, but not limited to, our mobile apps and various cloud-based services, content and websites (“Products”). Specifically, the policy exists to inform you about the types of information we may receive, how we use that information, the measures we take to safeguard the information we receive, the choices you may make and certain legal rights that you have."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本私隱政策適用於 AirType（invivo interactive limited）及我們的產品，包括但不限於流動應用程式、各種雲端服務、內容及網站（「產品」）。本政策旨在向你說明我們可能接收的資料類型、我們如何使用該等資料、我們為保障所接收資料而採取的措施、你可作出的選擇，以及你享有的若干法律權利。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本隐私政策适用于 AirType（invivo interactive limited）及我们的产品，包括但不限于流动应用程式、各种云端服务、内容及网站（「产品」）。本政策旨在向你说明我们可能接收的资料类型、我们如何使用该等资料、我们为保障所接收资料而采取的措施、你可作出的选择，以及你享有的若干法律权利。"
          }
        }
      }
    },
    "policy.1.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where we refer to “personal data” in this privacy policy we mean any data that may identify you as an individual."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本私隱政策所指的「個人資料」，是指任何可識別你個人身分的資料。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本隐私政策所指的「个人资料」，是指任何可识别你个人身分的资料。"
          }
        }
      }
    },
    "policy.2.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Overview of our privacy policy"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 私隱政策概要"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 隐私政策概要"
          }
        }
      }
    },
    "policy.2.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protecting your personal data and maintaining your trust is core to our mission at AirType."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保障你的個人資料及維持你的信任，是 AirType 使命的核心。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保障你的个人资料及维持你的信任，是 AirType 使命的核心。"
          }
        }
      }
    },
    "policy.2.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We will not sell your personal data to third parties."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們不會向第三方出售你的個人資料。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们不会向第三方出售你的个人资料。"
          }
        }
      }
    },
    "policy.2.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We receive different types of information from our Products, including anonymous device, network, performance and usage statistics. We use this data to debug and improve the functionality of our Products."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們會從產品接收不同類型的資料，包括匿名的裝置、網絡、效能及使用情況統計資料。我們會使用這些資料排除錯誤及改善產品功能。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会从产品接收不同类型的资料，包括匿名的装置、网络、效能及使用情况统计资料。我们会使用这些资料排除错误及改善产品功能。"
          }
        }
      }
    },
    "policy.2.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We may also receive your personal contact information contained in correspondence via our web sites and communications channels. This enables us to offer user support, beta testing communities, surveys, competitions and similar services."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們亦可能接收你透過我們的網站及通訊渠道來往時所提供的個人聯絡資料，以便提供用戶支援、測試版社群、問卷調查、比賽及類似服務。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们亦可能接收你透过我们的网站及通讯渠道来往时所提供的个人联络资料，以便提供用户支援、测试版社群、问卷调查、比赛及类似服务。"
          }
        }
      }
    },
    "policy.2.5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We constantly review and challenge the procedures we have in place for data handling and data security and have internal system and controls to ensure compliance."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們會持續檢視及審視現有的資料處理及資料保安程序，並設有內部系統及監控措施，以確保符合規定。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会持续检视及审视现有的资料处理及资料保安程序，并设有内部系统及监控措施，以确保符合规定。"
          }
        }
      }
    },
    "policy.3.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. How we protect your data"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 我們如何保障你的資料"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 我们如何保障你的资料"
          }
        }
      }
    },
    "policy.3.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All data transferred by us between your device and our services is encrypted, including any personal data we may collect and store on your behalf. For more information about how we guard your data securely, please read our Data Security Statement."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們在你的裝置與我們的服務之間傳輸的所有資料均會加密，包括我們可能代表你收集及儲存的任何個人資料。如欲了解我們如何安全地保護你的資料，請參閱我們的《資料保安聲明》。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们在你的装置与我们的服务之间传输的所有资料均会加密，包括我们可能代表你收集及储存的任何个人资料。如欲了解我们如何安全地保护你的资料，请参阅我们的《资料保安声明》。"
          }
        }
      }
    },
    "policy.4.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Third-party keyboard warnings"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "4. 第三方鍵盤警告"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "4. 第三方键盘警告"
          }
        }
      }
    },
    "policy.4.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may encounter an alert when installing our Products on your device, warning that third-party keyboards may collect or log sensitive data such as passwords, credit card numbers or street addresses."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在裝置上安裝我們的產品時，你可能會看到提示，警告第三方鍵盤可能收集或記錄密碼、信用卡號碼或住址等敏感資料。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在装置上安装我们的产品时，你可能会看到提示，警告第三方键盘可能收集或记录密码、信用卡号码或住址等敏感资料。"
          }
        }
      }
    },
    "policy.4.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AirType Products are designed not to receive, store or transmit any such sensitive data."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AirType 產品在設計上不會接收、儲存或傳輸任何上述敏感資料。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AirType 产品在设计上不会接收、储存或传输任何上述敏感资料。"
          }
        }
      }
    },
    "policy.4.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For more information or help, please see our iOS support pages."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如需更多資料或協助，請參閱我們的 iOS 支援頁面。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如需更多资料或协助，请参阅我们的 iOS 支援页面。"
          }
        }
      }
    },
    "policy.5.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5. Communicating with you"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "5. 與你聯絡"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "5. 与你联络"
          }
        }
      }
    },
    "policy.5.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may receive occasional notifications on your device alerting you to product updates and features that may be of interest to you. You can disable these notifications in our Products at any time by going to the Settings menu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的裝置可能偶爾會收到通知，向你介紹可能感興趣的產品更新及功能。你可隨時前往產品的「設定」選單停用這些通知。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的装置可能偶尔会收到通知，向你介绍可能感兴趣的产品更新及功能。你可随时前往产品的「设置」选单停用这些通知。"
          }
        }
      }
    },
    "policy.6.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "6. Sharing your information"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "6. 分享你的資料"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "6. 分享你的资料"
          }
        }
      }
    },
    "policy.6.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Except as stated in this privacy policy, we will not share your personal data with any third party unless you have given us permission. We may share anonymized data, where we have removed any personal data, with other parties."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除本私隱政策所述的情況外，未經你的許可，我們不會向任何第三方分享你的個人資料。我們可能會向其他各方分享已移除所有個人資料的匿名資料。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除本隐私政策所述的情况外，未经你的许可，我们不会向任何第三方分享你的个人资料。我们可能会向其他各方分享已移除所有个人资料的匿名资料。"
          }
        }
      }
    },
    "policy.6.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We may share your information (including but not limited to, information from cookies, log files, device identifiers, learned language data/Language Modeling Data and statistics) with businesses that are legally part of the same group of companies as invivo interactive limited, or that become part of that group (“Group Companies”). Group Companies may use this information to help provide, understand, and improve our Products (including by providing analytics and data analysis) and Group Companies own services."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們可能會與法律上屬於 invivo interactive limited 同一集團，或其後加入該集團的企業（「集團公司」）分享你的資料，包括但不限於 Cookie、日誌檔案、裝置識別碼、已學習的語言資料／語言模型資料及統計資料。集團公司可使用這些資料，協助提供、了解及改善我們的產品（包括提供分析及數據分析）以及集團公司本身的服務。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们可能会与法律上属于 invivo interactive limited 同一集团，或其后加入该集团的企业（「集团公司」）分享你的资料，包括但不限于 Cookie、日志档案、装置识别码、已学习的语言资料／语言模型资料及统计资料。集团公司可使用这些资料，协助提供、了解及改善我们的产品（包括提供分析及数据分析）以及集团公司本身的服务。"
          }
        }
      }
    },
    "policy.6.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We may share your information (including but not limited to, information from cookies, log files, device identifiers, learned language data/Language Modeling Data and statistics) with third-party organizations that help us provide our Products (“Service Providers”) such as providers of hosting services or analytics tools. Our Service Providers will only be given access to your information as is reasonably necessary and under appropriate confidentiality terms."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們可能會與協助我們提供產品的第三方機構（「服務供應商」），例如託管服務或分析工具供應商，分享你的資料，包括但不限於 Cookie、日誌檔案、裝置識別碼、已學習的語言資料／語言模型資料及統計資料。服務供應商只會在合理必要的範圍內，並在適當的保密條款下獲准存取你的資料。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们可能会与协助我们提供产品的第三方机构（「服务供应商」），例如托管服务或分析工具供应商，分享你的资料，包括但不限于 Cookie、日志档案、装置识别码、已学习的语言资料／语言模型资料及统计资料。服务供应商只会在合理必要的范围内，并在适当的保密条款下获准存取你的资料。"
          }
        }
      }
    },
    "policy.6.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Should you breach the terms and conditions or terms of use relating to any of our Products, or if we are under a duty to disclose any information to comply with a legal obligation, we may be forced to disclose your information to a relevant authority. Any disclosure of personal information will be made in accordance with Hong Kong SAR China legislation."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如你違反任何產品的條款及細則或使用條款，或我們有責任披露資料以履行法律義務，我們可能須向有關機關披露你的資料。任何個人資料披露均會按照中國香港特別行政區的法例進行。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如你违反任何产品的条款及细则或使用条款，或我们有责任披露资料以履行法律义务，我们可能须向有关机关披露你的资料。任何个人资料披露均会按照中国香港特别行政区的法例进行。"
          }
        }
      }
    },
    "policy.7.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "7. Accessing Your Information"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "7. 查閱你的資料"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "7. 查阅你的资料"
          }
        }
      }
    },
    "policy.7.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you wish to request access to and/or correction of your personal data held by us, you may do so in writing email to info@invivo.me."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如你希望要求查閱及／或更正我們持有的個人資料，可透過電郵以書面向 info@invivo.me 提出。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如你希望要求查阅及／或更正我们持有的个人资料，可透过电邮以书面向 info@invivo.me 提出。"
          }
        }
      }
    },
    "policy.8.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "8. Change of Control"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "8. 控制權變更"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "8. 控制权变更"
          }
        }
      }
    },
    "policy.8.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If we sell or otherwise transfer part or the whole of AirType or our assets to another organization (e.g., in the course of a transaction like a merger, acquisition, bankruptcy, dissolution or liquidation), information from or about our users may be among the items sold or transferred."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如我們向另一機構出售或以其他方式轉讓 AirType 或我們資產的部分或全部（例如在合併、收購、破產、解散或清盤等交易過程中），來自用戶或與用戶有關的資料可能屬於被出售或轉讓的項目。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如我们向另一机构出售或以其他方式转让 AirType 或我们资产的部分或全部（例如在合并、收购、破产、解散或清盘等交易过程中），来自用户或与用户有关的资料可能属于被出售或转让的项目。"
          }
        }
      }
    },
    "policy.8.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "However this will not affect your rights or our obligations under this privacy policy."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "但這不會影響你在本私隱政策下的權利，亦不會影響我們在本政策下的義務。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "但这不会影响你在本隐私政策下的权利，亦不会影响我们在本政策下的义务。"
          }
        }
      }
    },
    "policy.9.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "9. Policy Changes"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "9. 政策變更"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "9. 政策变更"
          }
        }
      }
    },
    "policy.9.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From time to time we may make changes to this privacy policy, which will be posted on our web sites and relevant communications channels. You are advised to check our web sites regularly to view our most recent privacy policy. We last updated our privacy policy on September 27, 2014, the key changes made are recorded in a change log here."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們可能不時更改本私隱政策，並於網站及相關通訊渠道公布。建議你定期瀏覽我們的網站，查閱最新的私隱政策。我們上次更新私隱政策的日期為 2014 年 9 月 27 日；所作的主要變更已記錄於變更紀錄中。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们可能不时更改本隐私政策，并于网站及相关通讯渠道公布。建议你定期浏览我们的网站，查阅最新的隐私政策。我们上次更新隐私政策的日期为 2014 年 9 月 27 日；所作的主要变更已记录于变更纪录中。"
          }
        }
      }
    },
