{
  "sourceLanguage": "en",
  "strings": {
    "AirType": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AirType"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AirType"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AirType"
          }
        }
      }
    },
    "Type on your computer. Send to your iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type on your computer. Send to your iPhone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在電腦打字，傳到 iPhone。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在电脑打字，传到 iPhone。"
          }
        }
      }
    },
    "Set up the keyboard": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up the keyboard"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定鍵盤"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置键盘"
          }
        }
      }
    },
    "Enable AirType and Allow Full Access in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable AirType and Allow Full Access in Settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「設定」啟用 AirType，並開啟「允許完整取用」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「设置」启用 AirType，并开启「允许完全访问」。"
          }
        }
      }
    },
    "Open Keyboard Settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Keyboard Settings"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟鍵盤設定"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启键盘设置"
          }
        }
      }
    },
    "Allow Local Network": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Local Network"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許區域網絡"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许本地网络"
          }
        }
      }
    },
    "Try AirType": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try AirType"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試用 AirType"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用 AirType"
          }
        }
      }
    },
    "Open a text field and use the globe key to select AirType.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a text field and use the globe key to select AirType."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟輸入欄，再用地球鍵選擇 AirType。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启输入栏，再用地球键选择 AirType。"
          }
        }
      }
    },
    "Advanced settings": {
      "localizations": {
        "en": {
          "stringUnit": {
